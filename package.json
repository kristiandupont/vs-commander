{
  "name": "vs-commander",
  "displayName": "VS Commander",
  "description": "A Norton Commander style dual-pane file manager for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:vsCommander.editor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "vsCommander.editor",
        "displayName": "VS Commander",
        "selector": [
          {
            "scheme": "untitled",
            "filenamePattern": "VS Commander Session *"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "vsCommander.new",
        "title": "New VS Commander Window"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && tsc -p ./tsconfig.webview.json && npm run build-webview",
    "build-webview": "esbuild out/webview/main.js --bundle --outfile=media/main.js --format=iife --minify && cp src/webview/main.css media/main.css",
    "watch": "tsc -watch -p ./ & tsc -watch -p ./tsconfig.webview.json",
    "watch-webview": "esbuild src/webview/main.ts --bundle --outfile=media/main.js --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.49.0",
    "@typescript-eslint/parser": "^5.49.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.0",
    "eslint": "^8.34.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^4.9.5"
  }
}
