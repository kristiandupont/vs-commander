{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "outDir": "media",
    "rootDir": "src/webview",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/webview/**/*"],
  "exclude": ["node_modules"]
}
